<body class="m-0 p-0 w-600px word-break-break-word bg-_0B0019"> <amp-state id="formState">
    <script type="application/json">
      {
        "formVisible": true,
        "prevPage": -1,
        "currentPage": 0,
        "nextPage": 1,
        "genres": {
          "action": false,
          "drama": false,
          "thrillers": false,
          "comedy": false,
          "horror": false,
          "musical": false,
          "documentary": false,
          "science-fiction": false
        }
      }
    </script>
  </amp-state>
  <div class="w-full flex flex-col items-center">
    <h1 class="font-sans font-normal text-2xl my-3 mx-0 text-white" [hidden]="!formState.formVisible">Tubi TV</h1>
    <h2 class="font-sans font-normal text-base my-3 mx-0 text-gray-300" [hidden]="!formState.formVisible">Select
      your favorite genres</h2>
    <form method="post" action-xhr="https://crm.production-public.tubi.io/api/v1/amp/recommendations" on="submit-success:AMP.setState({formState: {formVisible: false}})" class="w-full max-w-550px">
      <input type="hidden" name="country" value="US">
      <input type="hidden" name="limit" value="6">
      <div [hidden]="!formState.formVisible">
        <div class="flex flex-wrap w-full">
          <div class="flex flex-col flex-1">
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="action" class="checkbox" [class]="formState.genres.action ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {action: !formState.genres.action}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.action ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.action ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="action">Action</label>
              <input type="checkbox" name="genres[]" value="action" [checked]="formState.genres.action" hidden="">
            </div>
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="drama" class="checkbox" [class]="formState.genres.drama ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {drama: !formState.genres.drama}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.drama ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.drama ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="drama">Drama</label>
              <input type="checkbox" name="genres[]" value="drama" [checked]="formState.genres.drama" hidden="">
            </div>
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="horror" class="checkbox" [class]="formState.genres.horror ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {horror: !formState.genres.horror}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.horror ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.horror ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="horror">Horror</label>
              <input type="checkbox" name="genres[]" value="horror" [checked]="formState.genres.horror" hidden="">
            </div>
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="musical" class="checkbox" [class]="formState.genres.musical ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {musical: !formState.genres.musical}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.musical ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.musical ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="musical">Musical</label>
              <input type="checkbox" name="genres[]" value="musical" [checked]="formState.genres.musical" hidden="">
            </div>
          </div>
          <div class="flex flex-col flex-1">
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="thrillers" class="checkbox" [class]="formState.genres.thrillers ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {thrillers: !formState.genres.thrillers}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.thrillers ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.thrillers ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="thrillers">Thriller</label>
              <input type="checkbox" name="genres[]" value="thrillers" [checked]="formState.genres.thrillers" hidden="">
            </div>
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="comedy" class="checkbox" [class]="formState.genres.comedy ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {comedy: !formState.genres.comedy}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.comedy ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.comedy ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="comedy">Comedy</label>
              <input type="checkbox" name="genres[]" value="comedy" [checked]="formState.genres.comedy" hidden="">
            </div>
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="documentary" class="checkbox" [class]="formState.genres.documentary ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {documentary: !formState.genres.documentary}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.documentary ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.documentary ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="documentary">Documentary</label>
              <input type="checkbox" name="genres[]" value="documentary" [checked]="formState.genres.documentary" hidden="">
            </div>
            <div class="flex items-center m-7px p-3_5 rounded-md border border-gray border-solid">
              <div id="science-fiction" class="checkbox" [class]="formState.genres.sci_fi_and_fantasy ? 'checkbox checked' : 'checkbox'" on="tap:AMP.setState({formState: {genres: {sci_fi_and_fantasy: !formState.genres.sci_fi_and_fantasy}}})" role="button" tabindex="0">
                <span class="checkmark" [class]="formState.genres.sci_fi_and_fantasy ? 'checkmark checkmark-active' : 'checkmark'" [text]="formState.genres.sci_fi_and_fantasy ? '✔' : ''">&#10003;</span>
              </div>
              <label class="text-white text-xs font-sans" for="science-fiction">Science Fiction</label>
              <input type="checkbox" name="genres[]" value="sci_fi_and_fantasy" [checked]="formState.genres.sci_fi_and_fantasy" hidden="">
            </div>
          </div>
        </div>
        <div class="flex justify-center items-center p-5">
          <input type="submit" class="text-white w-16 h-9 rounded-md cursor-pointer text-xs font-bold my-0 mx-2_5 bg-_ffffff33 border-none" value="Next" [hidden]="!formState.formVisible">
        </div>
      </div>
      <div submit-success="">
        <template type="amp-mustache">
          <div class="flex flex-col justify-center items-center">
            <h1 class="font-sans font-normal text-2xl mt-3 mb-0 mx-0 text-white text-center" [hidden]="formState.formVisible">
              Tubi
              TV</h1>
            <h2 class="font-sans font-normal text-base my-3 mx-0 text-gray-300 text-center" [hidden]="formState.formVisible">
              Here's something for you!</h2>
            <div class="flex flex-wrap justify-evenly items-center md-w-550px">
              {% raw %}
                {{#items}}
                  <div class="flex flex-col items-center w-calc33_33pc-8px p-1 pb-7">
                    <a href="{{url}}" class="relative rounded-md" target="_blank">
                      <amp-img class="rounded-md hidden md-block" src="{{amp_email_poster}}" width="141" height="196"></amp-img>
                      <amp-img class="rounded-md md-hidden" src="{{amp_email_poster}}" width="101" height="140"></amp-img>
                      <span class="absolute bottom-3 right-2 rounded-full bg-_FFFF13 w-7 h-7 leading-7 text-sm text-black text-center pl-0_5 pt-1px">▶</span>
                    </a>
                    <p class="text-white m-0 text-0_8rem md-text-1rem font-sans">{{title}}</p>
                  </div>
                {{/items}}
              {% endraw %}
            </div>
            <div class="flex justify-center items-center p-5" [hidden]="formState.formVisible">
              <a href="https://tubi.tv" target="_blank" class="w-20 h-9 bg-_FFFF13 rounded-md cursor-pointer text-xs font-sans font-bold flex justify-center items-center text-black no-underline">
                See More
              </a>
            </div>
          </div>
        </template>
      </div>
      <div submit-error="">
        <template type="amp-mustache">
          <span class="text-white">Oops, we didn't receive expected response.</span>
        </template>
      </div>
    </form>
  </div>
</body>
</html>