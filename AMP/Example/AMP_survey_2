    .amp-carousel-slide {
      width: 100%;
    }
    .amp-carousel-button {
      display: none;
    }
    .checkbox {
      display: inline-block;
      width: 10px;
      height: 10px;
      margin: 4px;
      border-radius: 4px;
      border: 2px solid #666;
      position: relative;
      cursor: pointer;
      text-align: center;
      line-height: 10px;
    }
    .checked {
      border: 2px solid transparent;
      background-color: #FFFF13;
    }
    .checkmark {
      display: none;
      color: #0B0019;
      font-size: 12px;
    }
    .checkmark-active {
      display: inline-block;
      padding-top: 0;
