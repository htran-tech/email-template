    }
    .w-20 {
      width: 80px;
    }
    .w-7 {
      width: 28px;
    }
    .w-600px {
      width: 600px;
    }
    .w-calc33_33pc-8px {
      width: calc(33.33% - 8px);
    }
    .w-full {
      width: 100%;
    }
    .max-w-550px {
      max-width: 550px;
    }
    .flex-1 {
      flex: 1 1 0%;
    }
    .cursor-pointer {
      cursor: pointer;
    }
    .flex-col {
      flex-direction: column;
    }
    .flex-wrap {
      flex-wrap: wrap;
    }
    .items-center {
      align-items: center;
    }
    .justify-center {
      justify-content: center;
    }
    .justify-evenly {
